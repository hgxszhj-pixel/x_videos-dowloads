import { ProgressIndicator } from "std-widgets.slint";

export component AppWindow inherits Window {
    title: "X Video Downloader";
    min_width: 500px;
    max_width: 1200px;
    min_height: 500px;
    max_height: 1300px;

    // Global font property that child elements can reference
    in-out property <string> ui-font: "PingFang SC";
    in-out property <string> url: "";
    in-out property <string> output-dir: "";
    in-out property <string> cookie-file: "";
    in-out property <string> video-title: "";
    in-out property <string> video-uploader: "";
    in-out property <string> video-duration: "";
    in-out property <string> video-formats: "";
    in-out property <bool> is-fetching: false;
    in-out property <bool> is-downloading: false;
    in-out property <float> download-progress: 0.0;
    in-out property <string> download-speed: "";
    in-out property <string> download-eta: "";
    in-out property <string> download-threads: "";
    in-out property <string> status-message: "Enter video URL";
    in-out property <string> network-status: "Checking";
    in-out property <string> error-message: "";
    in-out property <string> error-action: "";
    in-out property <bool> has-video-info: false;

    // Download pool for multiple URLs
    in-out property <string> download-pool: "";

    // Per-URL progress list (JSON array for multi-progress display)
    in-out property <string> download-list-progress: "";
    in-out property <int> download-list-remaining: 0;

    // Batch download state
    in-out property <bool> is-batch-mode: false;
    in-out property <string> batch-urls: "";
    in-out property <int> batch-current: 0;
    in-out property <int> batch-total: 0;
    in-out property <string> batch-status: "";
    in-out property <float> batch-progress: 0.0;

    // History/Bookmark list
    in-out property <string> selected-tab: "history";
    in-out property <string> filter-status: "all";
    in-out property <string> filter-platform: "all";
    in-out property <string> history-list: "";
    in-out property <string> selected-history-id: "";

    callback fetch-info();
    callback start-download();
    callback start-batch-download();
    callback cancel-download();
    callback save-config();
    callback browse-cookie();
    callback clear-url();
    callback tick();
    callback check-network();
    callback select-history(id: string);
    callback add-bookmark();
    callback remove-history(id: string);

    VerticalLayout {
        padding: 24px;
        spacing: 16px;

        // Header with Network Status
        HorizontalLayout {
            spacing: 12px;
            Text {
                text: "X Video Downloader";
                font-size: 28px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            // Network Status Indicator
            Rectangle {
                border-radius: 12px;
                border-width: 1px;
                border-color: root.network-status == "Online" ? #34a853 : (root.network-status == "Checking" ? #f9a825 : #c62828);
                background: root.network-status == "Online" ? #e8f5e9 : (root.network-status == "Checking" ? #fff8e1 : #ffebee);
                height: 36px;
                width: 120px;
                horizontal-stretch: 0;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;
                    alignment: center;
                    Rectangle {
                        width: 12px;
                        height: 12px;
                        border-radius: 6px;
                        background: root.network-status == "Online" ? #34a853 : (root.network-status == "Checking" ? #f9a825 : #c62828);
                    }
                    Text {
                        text: root.network-status;
                        font-size: 14px;
                        font-weight: 600;
                        color: root.network-status == "Online" ? #2e7d32 : (root.network-status == "Checking" ? #f57f17 : #c62828);
                        vertical-alignment: center;
                    }
                }
            }
        }

        // URL Section
        Text {
            text: "Video URL(s)";
            font-size: 14px;
            font-weight: 600;
        }

        Rectangle {
            background: white;
            border-radius: 6px;
            border-width: 1px;
            border-color: #ccc;
            height: 40px;
            HorizontalLayout {
                padding-left: 12px;
                TextInput {
                    text <=> root.url;
                    font-size: 14px;
                    color: black;
                    vertical-alignment: center;
                    enabled: true;
                }
            }
        }

        Text {
            text: "Enter URL(s), separate multiple URLs with spaces or commas";
            font-size: 11px;
            color: #888;
        }

        // Action Buttons
        HorizontalLayout {
            spacing: 16px;
            height: 44px;

            Rectangle {
                background: root.is-fetching ? #cccccc : #4285f4;
                border-radius: 6px;
                width: 140px;
                horizontal-stretch: 0;
                Text {
                    text: root.is-fetching ? "Fetching..." : "Fetch Info";
                    color: white;
                    font-size: 15px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    clicked => { root.fetch-info(); }
                    enabled: !root.is-fetching && root.url != "";
                }
            }

            Rectangle {
                background: root.is-downloading || !root.has-video-info ? #cccccc : #34a853;
                border-radius: 6px;
                width: 140px;
                horizontal-stretch: 0;
                Text {
                    text: root.is-downloading ? "Downloading..." : "Download";
                    color: white;
                    font-size: 15px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    clicked => { root.start-download(); }
                    enabled: !root.is-downloading && root.has-video-info;
                }
            }

            Rectangle {
                background: #4285f4;
                border-radius: 6px;
                width: 120px;
                horizontal-stretch: 0;
                TouchArea { clicked => { root.save-config(); } }
                Text {
                    text: "Save";
                    color: white;
                    font-size: 14px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                background: #666666;
                border-radius: 6px;
                width: 80px;
                horizontal-stretch: 0;
                TouchArea { clicked => { root.clear-url(); } }
                Text {
                    text: "Clear";
                    color: white;
                    font-size: 14px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // Video Info Section
        Rectangle {
            visible: root.has-video-info;
            background: #f8f9fa;
            border-radius: 8px;
            VerticalLayout {
                spacing: 8px;
                padding: 16px;
                Text {
                    text: "Video Information";
                    font-size: 16px;
                    font-weight: 700;
                    color: #333;
                }
                Text {
                    text: "Title: " + root.video-title;
                    font-size: 13px;
                    color: #555;
                }
                Text {
                    text: "Uploader: " + root.video-uploader;
                    font-size: 13px;
                    color: #555;
                }
                Text {
                    text: "Duration: " + root.video-duration;
                    font-size: 13px;
                    color: #555;
                }
            }
        }

        // Progress Section (Multi-URL support)
        Rectangle {
            visible: root.is-downloading;
            background: #e8f5e9;
            border-radius: 8px;
            VerticalLayout {
                spacing: 8px;
                padding: 16px;
                // Batch progress header
                Text {
                    text: "Downloading " + root.batch-total + " video(s) - " + root.batch-status;
                    font-size: 14px;
                    font-weight: 600;
                    color: #2e7d32;
                }
                // Overall batch progress bar
                ProgressIndicator {
                    progress: root.batch-progress / 100.0;
                    indeterminate: false;
                    height: 16px;
                }
                // Per-URL progress list (from JSON)
                if root.download-list-progress != "": Rectangle {
                    background: white;
                    border-radius: 4px;
                    VerticalLayout {
                        padding: 8px;
                        spacing: 4px;
                        Text {
                            text: root.download-list-progress;
                            font-size: 11px;
                            color: #333;
                            wrap: word-wrap;
                        }
                        if root.download-list-remaining > 0: Text {
                            text: "... and " + root.download-list-remaining + " more download(s)";
                            font-size: 11px;
                            color: #888;
                        }
                    }
                }
                // Cancel button
                Rectangle {
                    background: #c62828;
                    border-radius: 6px;
                    height: 36px;
                    width: 100px;
                    TouchArea { clicked => { root.cancel-download(); } }
                    Text {
                        text: "Cancel";
                        color: white;
                        font-size: 14px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Status Message
        if root.status-message != "" && !root.is-downloading: Text {
            text: root.status-message;
            font-size: 13px;
            horizontal-alignment: center;
            color: #666;
        }

        // Error Message
        Rectangle {
            visible: root.error-message != "";
            background: #ffebee;
            border-radius: 6px;
            VerticalLayout {
                spacing: 6px;
                padding: 12px;
                Text {
                    text: root.error-message;
                    font-size: 13px;
                    color: #c62828;
                }
                if root.error-action != "": Text {
                    text: "Tip: " + root.error-action;
                    font-size: 12px;
                    color: #1976d2;
                }
            }
        }

        // History/Bookmark List Display
        if root.history-list != "" && root.history-list != "No items": Rectangle {
            background: #f8f9fa;
            border-radius: 6px;
            height: 80px;
            VerticalLayout {
                padding: 8px;
                Text {
                    text: root.history-list;
                    font-size: 11px;
                    color: #555;
                    wrap: word-wrap;
                }
            }
        }

        // Settings Section
        Rectangle {
            background: #f5f5f5;
            border-radius: 8px;
            VerticalLayout {
                spacing: 12px;
                padding: 16px;
                Text {
                    text: "Settings";
                    font-size: 16px;
                    font-weight: 700;
                    color: #333;
                }

                Text {
                    text: "Output Directory";
                    font-size: 12px;
                    font-weight: 600;
                    color: #555;
                }
                Rectangle {
                    background: white;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: #ccc;
                    height: 32px;
                    HorizontalLayout {
                        padding-left: 8px;
                        TextInput {
                            text <=> root.output-dir;
                            font-size: 12px;
                            color: black;
                            vertical-alignment: center;
                        }
                    }
                }

                Text {
                    text: "Cookie File (optional)";
                    font-size: 12px;
                    font-weight: 600;
                    color: #555;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        background: white;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: #ccc;
                        height: 32px;
                        horizontal-stretch: 1;
                        HorizontalLayout {
                            padding-left: 8px;
                            TextInput {
                                text <=> root.cookie-file;
                                font-size: 12px;
                                color: black;
                                vertical-alignment: center;
                            }
                        }
                    }
                    Rectangle {
                        background: #666666;
                        border-radius: 4px;
                        width: 70px;
                        height: 32px;
                        TouchArea { clicked => { root.browse-cookie(); } }
                        Text {
                            text: "Browse";
                            color: white;
                            font-size: 12px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
