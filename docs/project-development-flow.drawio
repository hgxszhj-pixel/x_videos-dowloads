        </mxCell>

        <mxCell id="p2" value="技术设计&#xa;/Plan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F3FF;strokeColor=#0066CC;fontSize=14;align=center;" vertex="1" parent="1">
