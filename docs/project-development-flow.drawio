<mxfile>
  <diagram name="Project Development Workflow">
    <mxGraphModel dx="1200" dy="900" grid="1" guides="1">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
