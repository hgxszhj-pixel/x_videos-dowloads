          <mxGeometry x="400" y="20" width="300" height="40" as="geometry"/>
        </mxCell>

        <!-- Main Flow - Row 1 -->
        <mxCell id="p1" value="需求分析&#xa;/Spec" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F3FF;strokeColor=#0066CC;fontSize=14;align=center;" vertex="1" parent="1">
