{
  "manifest_version": 3,
  "name": "CatCatch - m3u8 URL 拦截器",
  "version": "1.0.0",
  "description": "拦截小鹅通等平台的视频 m3u8 URL，方便下载",
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.xiaoeknow.com/*",
    "*://*.xiaoe-tech.com/*",
    "*://*.tulingpyton.cn/*",
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "CatCatch m3u8 拦截器"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
