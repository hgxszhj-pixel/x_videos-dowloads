#!/usr/bin/env python3
"""Git commit-msg Hook: 自动注入 Agent DID + 可验证凭证

效果: 每次 git commit 时,自动在 commit message 末尾追加:
    [DID: did:local:xxx] [VC: <hash>] rep=<score>
"""

import os
import subprocess
import sys
from pathlib import Path


def _find_agent_did() -> Path | None:
    """定位 scripts/agent_did.py — Hook 安装后位置变化,需用 git root 查找"""
    try:
        repo_root = subprocess.check_output(
            ["git", "rev-parse", "--show-toplevel"], text=True
        ).strip()
    except (subprocess.CalledProcessError, FileNotFoundError):
        return None

    candidate = Path(repo_root) / "scripts" / "agent_did.py"
    return candidate if candidate.exists() else None


MSG_FILE = sys.argv[1] if len(sys.argv) > 1 else None
if not MSG_FILE:
    sys.exit(0)

msg_path = Path(MSG_FILE)
original = msg_path.read_text()

# 已签发过 VC 的 commit 跳过
if "[DID:" in original or "[VC:" in original:
    sys.exit(0)

agent_did_path = _find_agent_did()
if not agent_did_path:
    # Hook 安装失败或文件被删 — 不阻塞 commit
    sys.exit(0)

sys.path.insert(0, str(agent_did_path.parent))
from agent_did import issue_did, get_reputation  # noqa: E402

did = issue_did()
rep = get_reputation()

commit_hash = os.environ.get("AGENT_COMMIT_HASH", "pending")

evaluators = os.environ.get("AGENT_EVALUATORS", "")
eval_summary = ""
if evaluators:
    parts = []
    for r in evaluators.split(","):
        if ":" in r:
            n, v = r.split(":", 1)
            parts.append(f"{n}:{v}")
    eval_summary = f" | eval={'/'.join(parts)}" if parts else ""

score = rep.get("score", 50.0)
warn = ""
if score < 30:
    warn = f"\n\n⚠️ Agent reputation low: {score:.1f}/100"

trailer = f"\n\n[DID: {did['id']}] [VC: {commit_hash}] rep={score:.1f}{eval_summary}{warn}"

msg_path.write_text(original + trailer)