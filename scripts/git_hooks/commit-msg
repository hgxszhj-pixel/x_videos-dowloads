#!/usr/bin/env python3
"""Git commit-msg Hook: 自动注入 Agent DID + 可验证凭证

效果: 每次 git commit 时,自动在 commit message 末尾追加:
    [DID: did:local:xxx] [VC: <hash>] rep=<score>

中间还会自动注入:
- Intent Lock 校验(commit msg 必须含 "Intent: <一句话>" 行,否则拒绝)
- Ref-trace 关联(若今天有 NDJSON trace,追加 Ref-trace: <绝对路径>)
"""

# hook 由 git 用 /usr/bin/env python3 启动 —— 交互 shell 里可能是 3.9（ServBay 别名），
# `Path | None` 这种注解在 3.9 上会在 def 时直接 TypeError，整个 hook 崩、commit 被拒。
from __future__ import annotations

import os
import subprocess
import sys
from pathlib import Path


def _find_agent_did() -> Path | None:
    """定位 scripts/agent_did.py — Hook 安装后位置变化,需用 git root 查找"""
    try:
        repo_root = subprocess.check_output(
            ["git", "rev-parse", "--show-toplevel"], text=True
        ).strip()
    except (subprocess.CalledProcessError, FileNotFoundError):
        return None

    candidate = Path(repo_root) / "scripts" / "agent_did.py"
    return candidate if candidate.exists() else None


MSG_FILE = sys.argv[1] if len(sys.argv) > 1 else None
if not MSG_FILE:
    sys.exit(0)

msg_path = Path(MSG_FILE)
original = msg_path.read_text()

# 已签发过 VC 的 commit 跳过
if "[DID:" in original or "[VC:" in original:
    sys.exit(0)

# === Intent Lock 校验 (在 DID/VC trailer 注入之前) ===
# 要求 commit message 含一行 "Intent: <一句话>"，否则拒绝。
# 详见 scripts/intent_lock.py
_intent_script = (
    Path(subprocess.check_output(["git", "rev-parse", "--show-toplevel"], text=True).strip())
    / "scripts"
    / "intent_lock.py"
)
if _intent_script.exists():
    sys.path.insert(0, str(_intent_script.parent))
    from intent_lock import validate_intent  # noqa: E402

    ok, _intent_msg = validate_intent(original)
    if not ok:
        print(_intent_msg, file=sys.stderr)
        sys.exit(1)
    print(_intent_msg, file=sys.stderr)

# === HANDOFF.md size guard (Intent Lock 之后 / Ref-trace 之前) ===
# > 200 行拒绝 commit (强制精简),> 100 行警告;只在 HANDOFF.md 是 commit 一部分时触发
_handoff_guard_path = (
    Path(subprocess.check_output(["git", "rev-parse", "--show-toplevel"], text=True).strip())
    / "scripts"
    / "handoff_size_guard.py"
)
if _handoff_guard_path.exists():
    sys.path.insert(0, str(_handoff_guard_path.parent))
    from handoff_size_guard import check_handoff_size  # noqa: E402

    _handoff_ok, _handoff_msg = check_handoff_size()
    if _handoff_msg:
        print(_handoff_msg, file=sys.stderr)
    if not _handoff_ok:
        sys.exit(1)

# === Ref-trace 自动注入 (Intent Lock 之后 / DID/VC 之前) ===
# 若今天 ~/.local/share/x_videos-dowloads-trace/YYYY-MM-DD/ 下有 NDJSON,
# 自动追加 "Ref-trace: <绝对路径>" 到 commit message。
# 详见 scripts/trace_link.py
_trace_link_path = (
    Path(subprocess.check_output(["git", "rev-parse", "--show-toplevel"], text=True).strip())
    / "scripts"
    / "trace_link.py"
)
if _trace_link_path.exists():
    sys.path.insert(0, str(_trace_link_path.parent))
    from trace_link import inject_ref_trace  # noqa: E402

    original, _trace_injected = inject_ref_trace(original)
    if _trace_injected:
        msg_path.write_text(original)  # 先写回,后注入 DID/VC trailer 会再读一次
        print(f"[commit-msg] Ref-trace 已注入", file=sys.stderr)

agent_did_path = _find_agent_did()
if not agent_did_path:
    # Hook 安装失败或文件被删 — 不阻塞 commit
    sys.exit(0)

sys.path.insert(0, str(agent_did_path.parent))
from agent_did import issue_did, get_reputation  # noqa: E402

did = issue_did()
rep = get_reputation()

commit_hash = os.environ.get("AGENT_COMMIT_HASH", "pending")

evaluators = os.environ.get("AGENT_EVALUATORS", "")
eval_summary = ""
if evaluators:
    parts = []
    for r in evaluators.split(","):
        if ":" in r:
            n, v = r.split(":", 1)
            parts.append(f"{n}:{v}")
    eval_summary = f" | eval={'/'.join(parts)}" if parts else ""

score = rep.get("score", 50.0)
warn = ""
if score < 30:
    warn = f"\n\n⚠️ Agent reputation low: {score:.1f}/100"

trailer = f"\n\n[DID: {did['id']}] [VC: {commit_hash}] rep={score:.1f}{eval_summary}{warn}"

msg_path.write_text(original + trailer)